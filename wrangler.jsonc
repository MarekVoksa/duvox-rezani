// Cloudflare Workers config. Deploying (`npx wrangler deploy`, which Cloudflare runs on every push) first runs build.sh.
{
  "name": "duvox-rezani",
  "main": "server/worker.js",
  "compatibility_date": "2025-01-01",
  "build": { "command": "sh build.sh" },
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "duvox-rezani", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  // Cloudflare Access: team domain (e.g. duvox.cloudflareaccess.com) and the application's AUD tag.
  // Until both are set the server refuses every request, so the data is never open.
  "vars": { "TEAM_DOMAIN": "", "POLICY_AUD": "" }
}
