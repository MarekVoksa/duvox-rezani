// Cloudflare Workers config. Deploying (`npx wrangler deploy`, which Cloudflare runs on every push) first runs build.sh.
{
  "name": "duvox-rezani",
  "main": "server/worker.js",
  "compatibility_date": "2025-01-01",
  "build": { "command": "sh build.sh" },
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "duvox-rezani", "database_id": "e09eb553-84c1-4562-bffb-fdb0c80fc5ac" }
  ],
  // Cloudflare Access: team domain (e.g. duvox.cloudflareaccess.com) and the application's AUD tag.
  // Until both are set the server refuses every request, so the data is never open.
  "vars": { "TEAM_DOMAIN": "duvox.cloudflareaccess.com", "POLICY_AUD": "c27d7d2ea31755f39a330baeb02ec17d60cb16554056a97da7990934279a2c6a" }
}
